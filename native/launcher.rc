#include <winver.h>

// Icon id 1: Explorer and the taskbar show the lowest-numbered icon resource,
// so this one has to stay first.
1 ICON "neuralscreen.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,5,6,0
 PRODUCTVERSION 1,5,6,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "NeuralScreen - DLSS 5 Neural Rendering overlay"
            VALUE "FileVersion", "1.7.0.0"
            VALUE "InternalName", "NeuralScreen"
            VALUE "OriginalFilename", "NeuralScreen.exe"
            VALUE "ProductName", "NeuralScreen"
            VALUE "ProductVersion", "1.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
